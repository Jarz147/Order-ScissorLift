[
  {
    "id": "scissor-http-in",
    "type": "http in",
    "z": "scissor-flow",
    "name": "Terima approval pemesanan",
    "url": "/scissor/approve",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 160,
    "y": 120,
    "wires": [["scissor-func"]]
  },
  {
    "id": "scissor-func",
    "type": "function",
    "z": "scissor-flow",
    "name": "Validasi & format payload",
    "func": "// Cek token pengaman (cocokkan dengan NODERED_TOKEN di Edge Function)\nconst token = msg.req.headers['x-nodered-token'] || '';\nif (token !== 'SDI_RELAY_TOKEN') {\n  msg.statusCode = 401;\n  msg.payload = { error: 'Unauthorized' };\n  return msg;\n}\n\nconst b = msg.payload || {};\nmsg.topic = 'scissor/lift/status';\nmsg.payload = JSON.stringify({\n  event: 'booking_approved',\n  lift: b.lift_code || b.lift || '',\n  pemesan: b.user_name || '',\n  mulai: b.start_date || '',\n  selesai: b.end_date || '',\n  status: 'aktif'\n});\nmsg.statusCode = 200;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 120,
    "wires": [["scissor-mqtt-out"]]
  },
  {
    "id": "scissor-mqtt-out",
    "type": "mqtt out",
    "z": "scissor-flow",
    "name": "Publish ke MQTT",
    "topic": "scissor/lift/status",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "scissor-broker",
    "x": 640,
    "y": 120,
    "wires": []
  },
  {
    "id": "scissor-broker",
    "type": "mqtt-broker",
    "name": "Broker MQTT SDI",
    "broker": "192.168.137.188",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
